  "prereqs": {
    "npm": {
      "label": "Node.js + npm",
      "check": "npm",
      "hint": {
        "default": "安装 Node.js 18+（https://nodejs.org）",
        "linux": "sudo apt install nodejs npm   # 或使用 nvm",
        "wsl": "sudo apt install nodejs npm   # 或使用 nvm",
        "macos": "brew install node",
        "windows": "winget install OpenJS.NodeJS.LTS"
      }
    },
    "uv": {
      "label": "uv（Python 工具管理器）",
      "check": "uv",
      "hint": {
        "default": "curl -LsSf https://astral.sh/uv/install.sh | sh",
        "windows": "powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\""
      }
    },
    "pipx": {
      "label": "pipx",
      "check": "pipx",
      "hint": {
        "default": "python3 -m pip install --user pipx && python3 -m pipx ensurepath",
        "windows": "py -3 -m pip install --user pipx"
      }
    },
    "vscode": {
      "label": "VS Code CLI（code）",
      "check": "code",
      "hint": {
        "default": "安装 VS Code 并在 PATH 中启用 code 命令",
        "windows": "winget install Microsoft.VisualStudioCode"
      }
    },
    "winget": {
      "label": "winget（Windows 包管理器）",
      "check": "winget",
      "hint": {
        "default": "Windows 10 1809+ 自带；在 Microsoft Store 更新“应用安装程序”",
        "windows": "在 Microsoft Store 更新“应用安装程序”"
      }
    },
    "bash": {
      "label": "bash + curl",
      "check": "bash",
      "hint": {
        "default": "需要 bash 与 curl 执行官方安装脚本",
        "windows": "建议使用 WSL：wsl --install"
      }
    }
  },
